<Window x:Class="EliteBioRadar.ScanLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scan Log — Galactic Survey"
        Width="820" Height="680"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#0a0f0f"
        FontFamily="Consolas">

    <Window.Resources>
        <!-- Thin scrollbar for lists — matches MainWindow's ThinScrollViewer -->
        <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/>
            <Setter Property="MinWidth" Value="5"/>
            <Setter Property="Background" Value="#0d1a1a"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="5">
                            <Border Background="#0d1a1a" CornerRadius="1"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#1a4444" CornerRadius="1" Margin="0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThinScrollViewer" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Style="{StaticResource ThinScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabHeader" TargetType="Border">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#0d1a1a" BorderBrush="#1a4444"
                BorderThickness="0,0,0,1" Padding="14,12,10,10">
            <DockPanel>
                <Button x:Name="btnClose" DockPanel.Dock="Right" Content="✕"
                        Width="22" Height="22" Padding="0"
                        Background="#0a1616" Foreground="#88bbbb"
                        BorderBrush="#1a4444" BorderThickness="1"
                        FontFamily="Consolas" FontSize="12"
                        Click="BtnClose_Click"/>
                <TextBlock Text="SCAN LOG — GALACTIC SURVEY" Foreground="#00e5ff"
                           FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- TABS -->
        <Border Grid.Row="1" Background="#0a0f0f" BorderBrush="#153636"
                BorderThickness="0,0,0,1" Padding="10,6,10,0">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="tabBio" Style="{StaticResource TabHeader}"
                        BorderBrush="#00e5ff" MouseLeftButtonUp="TabBio_Click">
                    <TextBlock x:Name="txtTabBio" Text="BIOLOGY" Foreground="#00e5ff"
                               FontSize="12" FontWeight="Bold"/>
                </Border>
                <Border x:Name="tabGeo" Style="{StaticResource TabHeader}"
                        MouseLeftButtonUp="TabGeo_Click">
                    <TextBlock x:Name="txtTabGeo" Text="GEOLOGY" Foreground="#4c7373"
                               FontSize="12" FontWeight="Bold"/>
                </Border>
                <Border x:Name="tabStellar" Style="{StaticResource TabHeader}"
                        MouseLeftButtonUp="TabStellar_Click">
                    <TextBlock x:Name="txtTabStellar" Text="STELLAR" Foreground="#4c7373"
                               FontSize="12" FontWeight="Bold"/>
                </Border>
                <Border x:Name="tabWorlds" Style="{StaticResource TabHeader}"
                        MouseLeftButtonUp="TabWorlds_Click">
                    <TextBlock x:Name="txtTabWorlds" Text="WORLDS" Foreground="#4c7373"
                               FontSize="12" FontWeight="Bold"/>
                </Border>
                <Border x:Name="tabPhenomena" Style="{StaticResource TabHeader}"
                        MouseLeftButtonUp="TabPhenomena_Click">
                    <TextBlock x:Name="txtTabPhenomena" Text="PHENOMENA" Foreground="#4c7373"
                               FontSize="12" FontWeight="Bold"/>
                </Border>
                <Border x:Name="tabJournals" Style="{StaticResource TabHeader}"
                        Margin="20,0,0,0" MouseLeftButtonUp="TabJournals_Click">
                    <TextBlock x:Name="txtTabJournals" Text="JOURNALS" Foreground="#4c7373"
                               FontSize="12" FontWeight="Bold"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- RANGE — persists across every tab, including Journals -->
        <Border Grid.Row="2" Background="#0a0f0f" BorderBrush="#153636"
                BorderThickness="0,0,0,1" Padding="10,7">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="RANGE  " Foreground="#4c7373" FontSize="11" VerticalAlignment="Center"/>
                    <Border x:Name="chipRange" BorderBrush="#00e5ff" BorderThickness="1"
                            CornerRadius="3" Padding="8,3" Margin="0,0,6,0" Cursor="Hand"
                            MouseLeftButtonUp="ChipRange_Click">
                        <TextBlock x:Name="txtChipRange" Text="Lifetime ▾" Foreground="#00e5ff" FontSize="11"/>
                    </Border>
                    <Border x:Name="btnRangeClear" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="3" Padding="8,3" Cursor="Hand"
                            MouseLeftButtonUp="BtnRangeClear_Click">
                        <TextBlock Text="Clear" Foreground="#4c7373" FontSize="11"/>
                    </Border>
                </StackPanel>

                <Border x:Name="rangePanel" Visibility="Collapsed"
                        Background="#0e1c1c" BorderBrush="#1a4444" BorderThickness="1"
                        CornerRadius="4" Padding="10" Margin="0,8,0,0" HorizontalAlignment="Left">
                    <StackPanel Width="280">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                            <Border x:Name="modeDateRange" BorderBrush="#00e5ff" BorderThickness="1"
                                    CornerRadius="3" Padding="0,5" Width="130" Margin="0,0,6,0"
                                    Cursor="Hand" HorizontalAlignment="Center"
                                    MouseLeftButtonUp="ModeDateRange_Click">
                                <TextBlock Text="Date Range" Foreground="#00e5ff" FontSize="11"
                                           HorizontalAlignment="Center"/>
                            </Border>
                            <Border x:Name="modeSince" BorderBrush="#4c7373" BorderThickness="1"
                                    CornerRadius="3" Padding="0,5" Width="130"
                                    Cursor="Hand" HorizontalAlignment="Center"
                                    MouseLeftButtonUp="ModeSince_Click">
                                <TextBlock x:Name="txtModeSince" Text="Since date" Foreground="#88bbbb" FontSize="11"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="dateRangeFields" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="From " Foreground="#4c7373" FontSize="10.5" VerticalAlignment="Center"/>
                            <DatePicker x:Name="dpFrom" Width="110" Margin="0,0,10,0" FontSize="11"/>
                            <TextBlock Text="To " Foreground="#4c7373" FontSize="10.5" VerticalAlignment="Center"/>
                            <DatePicker x:Name="dpTo" Width="110" FontSize="11"/>
                        </StackPanel>
                        <StackPanel x:Name="sinceFields" Orientation="Horizontal" Margin="0,0,0,10" Visibility="Collapsed">
                            <TextBlock Text="Since " Foreground="#4c7373" FontSize="10.5" VerticalAlignment="Center"/>
                            <DatePicker x:Name="dpSince" Width="110" FontSize="11"/>
                        </StackPanel>

                        <Border Background="#0f2a2a" BorderBrush="#0a8fa3" BorderThickness="1"
                                CornerRadius="3" Padding="0,6" Cursor="Hand"
                                MouseLeftButtonUp="BtnRangeApply_Click">
                            <TextBlock Text="Apply" Foreground="#00e5ff" FontSize="11.5" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- CONTENT -->
        <Grid Grid.Row="3">
            <!-- BIOLOGY -->
            <Grid x:Name="bioPanel" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="14,10,14,4">
                    <TextBlock Text="GROUP BY  " Foreground="#4c7373" FontSize="11" VerticalAlignment="Center"/>
                    <Border x:Name="chipBioGroupRegion" BorderBrush="#00e5ff" Background="#0f2a2a" BorderThickness="1"
                            CornerRadius="3" Padding="8,3" Margin="0,0,6,0" Cursor="Hand"
                            MouseLeftButtonUp="ChipBioGroupRegion_Click">
                        <TextBlock x:Name="txtChipBioGroupRegion" Text="Region" Foreground="#00e5ff" FontSize="11"/>
                    </Border>
                    <Border x:Name="chipBioGroupGenus" BorderBrush="#4c7373" BorderThickness="1"
                            CornerRadius="3" Padding="8,3" Cursor="Hand"
                            MouseLeftButtonUp="ChipBioGroupGenus_Click">
                        <TextBlock x:Name="txtChipBioGroupGenus" Text="Genus" Foreground="#88bbbb" FontSize="11"/>
                    </Border>
                </StackPanel>
                <ScrollViewer Grid.Row="1" Style="{StaticResource ThinScrollViewer}" Padding="14,0,14,14">
                    <StackPanel x:Name="bioStack"/>
                </ScrollViewer>
            </Grid>

            <!-- GEOLOGY -->
            <Grid x:Name="geoPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="14,10,14,4">
                    <TextBlock Text="GROUP BY  " Foreground="#4c7373" FontSize="11" VerticalAlignment="Center"/>
                    <Border x:Name="chipGeoGroupRegion" BorderBrush="#ffaa00" Background="#2a2210" BorderThickness="1"
                            CornerRadius="3" Padding="8,3" Margin="0,0,6,0" Cursor="Hand"
                            MouseLeftButtonUp="ChipGeoGroupRegion_Click">
                        <TextBlock x:Name="txtChipGeoGroupRegion" Text="Region" Foreground="#ffaa00" FontSize="11"/>
                    </Border>
                    <Border x:Name="chipGeoGroupType" BorderBrush="#4c7373" BorderThickness="1"
                            CornerRadius="3" Padding="8,3" Cursor="Hand"
                            MouseLeftButtonUp="ChipGeoGroupType_Click">
                        <TextBlock x:Name="txtChipGeoGroupType" Text="Site Type" Foreground="#88bbbb" FontSize="11"/>
                    </Border>
                </StackPanel>
                <ScrollViewer Grid.Row="1" Style="{StaticResource ThinScrollViewer}" Padding="14,0,14,14">
                    <StackPanel x:Name="geoStack"/>
                </ScrollViewer>
            </Grid>

            <!-- STELLAR -->
            <Grid x:Name="stellarPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="14,10,14,4">
                    <TextBlock Text="GROUP BY  " Foreground="#4c7373" FontSize="11" VerticalAlignment="Center"/>
                    <Border x:Name="chipStellarGroupRegion" BorderBrush="#ffd166" Background="#2a2410" BorderThickness="1"
                            CornerRadius="3" Padding="8,3" Margin="0,0,6,0" Cursor="Hand"
                            MouseLeftButtonUp="ChipStellarGroupRegion_Click">
                        <TextBlock x:Name="txtChipStellarGroupRegion" Text="Region" Foreground="#ffd166" FontSize="11"/>
                    </Border>
                    <Border x:Name="chipStellarGroupClass" BorderBrush="#4c7373" BorderThickness="1"
                            CornerRadius="3" Padding="8,3" Cursor="Hand"
                            MouseLeftButtonUp="ChipStellarGroupClass_Click">
                        <TextBlock x:Name="txtChipStellarGroupClass" Text="Star Class" Foreground="#88bbbb" FontSize="11"/>
                    </Border>
                </StackPanel>
                <ScrollViewer Grid.Row="1" Style="{StaticResource ThinScrollViewer}" Padding="14,0,14,14">
                    <StackPanel x:Name="stellarStack"/>
                </ScrollViewer>
            </Grid>

            <!-- WORLDS -->
            <Grid x:Name="worldsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="14,10,14,4">
                    <TextBlock Text="GROUP BY  " Foreground="#4c7373" FontSize="11" VerticalAlignment="Center"/>
                    <Border x:Name="chipWorldsGroupRegion" BorderBrush="#7ee787" Background="#123018" BorderThickness="1"
                            CornerRadius="3" Padding="8,3" Margin="0,0,6,0" Cursor="Hand"
                            MouseLeftButtonUp="ChipWorldsGroupRegion_Click">
                        <TextBlock x:Name="txtChipWorldsGroupRegion" Text="Region" Foreground="#7ee787" FontSize="11"/>
                    </Border>
                    <Border x:Name="chipWorldsGroupType" BorderBrush="#4c7373" BorderThickness="1"
                            CornerRadius="3" Padding="8,3" Cursor="Hand"
                            MouseLeftButtonUp="ChipWorldsGroupType_Click">
                        <TextBlock x:Name="txtChipWorldsGroupType" Text="Planet Type" Foreground="#88bbbb" FontSize="11"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="14,0,14,4">
                    <TextBlock Text="FILTER  " Foreground="#4c7373" FontSize="11" VerticalAlignment="Center"/>
                    <Border x:Name="chipTerraformable" BorderBrush="#4c7373" BorderThickness="1"
                            CornerRadius="3" Padding="8,3" Margin="0,0,6,0" Cursor="Hand"
                            MouseLeftButtonUp="ChipTerraformable_Click">
                        <TextBlock x:Name="txtChipTerraformable" Text="Terraformable only"
                                   Foreground="#88bbbb" FontSize="11"/>
                    </Border>
                    <Border x:Name="chipFootfalled" BorderBrush="#4c7373" BorderThickness="1"
                            CornerRadius="3" Padding="8,3" Cursor="Hand"
                            MouseLeftButtonUp="ChipFootfalled_Click">
                        <TextBlock x:Name="txtChipFootfalled" Text="Footfalled only"
                                   Foreground="#88bbbb" FontSize="11"/>
                    </Border>
                </StackPanel>
                <ScrollViewer Grid.Row="2" Style="{StaticResource ThinScrollViewer}" Padding="14,0,14,14">
                    <StackPanel x:Name="worldsStack"/>
                </ScrollViewer>
            </Grid>

            <!-- PHENOMENA -->
            <Grid x:Name="phenomenaPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="14,10,14,4">
                    <TextBlock Text="GROUP BY  " Foreground="#4c7373" FontSize="11" VerticalAlignment="Center"/>
                    <Border x:Name="chipPhenomenaGroupRegion" BorderBrush="#c792ea" Background="#241a2a" BorderThickness="1"
                            CornerRadius="3" Padding="8,3" Margin="0,0,6,0" Cursor="Hand"
                            MouseLeftButtonUp="ChipPhenomenaGroupRegion_Click">
                        <TextBlock x:Name="txtChipPhenomenaGroupRegion" Text="Region" Foreground="#c792ea" FontSize="11"/>
                    </Border>
                    <Border x:Name="chipPhenomenaGroupCategory" BorderBrush="#4c7373" BorderThickness="1"
                            CornerRadius="3" Padding="8,3" Cursor="Hand"
                            MouseLeftButtonUp="ChipPhenomenaGroupCategory_Click">
                        <TextBlock x:Name="txtChipPhenomenaGroupCategory" Text="Category" Foreground="#88bbbb" FontSize="11"/>
                    </Border>
                </StackPanel>
                <ScrollViewer Grid.Row="1" Style="{StaticResource ThinScrollViewer}" Padding="14,0,14,14">
                    <StackPanel x:Name="phenomenaStack"/>
                </ScrollViewer>
            </Grid>

            <!-- JOURNALS -->
            <StackPanel x:Name="journalsPanel" Visibility="Collapsed" Margin="20">
                <Border Background="#0a1515" BorderBrush="#153636" BorderThickness="1"
                        CornerRadius="4" Padding="16" Margin="0,0,0,14">
                    <DockPanel>
                        <Button x:Name="btnScanAll" DockPanel.Dock="Right" Content="Scan All"
                                Width="110" Height="32"
                                Background="#0f2a30" Foreground="#9db4c9"
                                BorderBrush="#5f7d90" FontFamily="Consolas" FontSize="12"
                                FontWeight="Bold" Click="BtnScanAll_Click"/>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="Scan All Journals" Foreground="#cfe8e8"
                                       FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Foreground="#4c7373" FontSize="11" TextWrapping="Wrap"
                                       Text="Re-reads every journal file on disk and rebuilds the lifetime library shown in Biology, Geology, Stellar, Worlds, and Phenomena. Safe to run any time — it never deletes anything, only fills in what it finds."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Background="#0a1515" BorderBrush="#153636" BorderThickness="1"
                        CornerRadius="4" Padding="16" Margin="0,0,0,14">
                    <DockPanel>
                        <Button x:Name="btnClearLibrary" DockPanel.Dock="Right" Content="Clear"
                                Width="110" Height="32"
                                Background="#2a1212" Foreground="#ff8080"
                                BorderBrush="#7a3535" FontFamily="Consolas" FontSize="12"
                                FontWeight="Bold" Click="BtnClearLibrary_Click"/>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="Clear Library" Foreground="#cfe8e8"
                                       FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Foreground="#4c7373" FontSize="11" TextWrapping="Wrap"
                                       Text="Wipes the cached scan library entirely — every region, genus, and site. You'd need to Scan All again afterward to rebuild it. This does not touch your actual Elite Dangerous journal files."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border BorderBrush="#153636" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                    <TextBlock x:Name="txtJournalsStatus" Foreground="#4c7373" FontSize="11"
                               TextWrapping="Wrap" Text="No scan has been run yet this session."/>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
