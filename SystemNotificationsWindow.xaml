<Window x:Class="EliteBioRadar.SystemNotificationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EliteBioRadar"
        Title="System Notifications"
        Width="720" Height="480"
        MinWidth="320" MinHeight="220"
        WindowStartupLocation="CenterOwner"
        Background="#080d0d"
        FontFamily="Consolas">

    <!-- A dark canvas the animations play on (see SystemNotificationsWindow.cs). Empty between animations. -->
    <Grid>
        <TextBlock Text="SYSTEM NOTIFICATIONS" Foreground="#1a4444" FontSize="16"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <!-- The atmosphere scene (descent / climb / jump) while one is under way, drawn by MainWindow at a wide size and scaled to the window; see ShowLiveScene. -->
        <Viewbox x:Name="liveSceneBox" Stretch="Uniform" Visibility="Collapsed" IsHitTestVisible="False">
            <Canvas x:Name="liveSceneCanvas" Background="#080d0d" ClipToBounds="True"/>
        </Viewbox>
        <local:FirstDiscoveryVisual x:Name="firstDiscoveryVisual"/>
        <local:LandedVisual x:Name="landedVisual"/>
        <local:LiftoffVisual x:Name="liftoffVisual"/>
        <local:FirstFootfallVisual x:Name="firstFootfallVisual"/>
        <local:SystemArrivalVisual x:Name="arrivalVisual"/>
        <local:JumpDepartureVisual x:Name="jumpDepartureVisual"/>
        <local:FuelScoopVisual x:Name="fuelScoopVisual"/>
        <local:CombatModeVisual x:Name="combatModeVisual"/>
        <local:AnalysisModeVisual x:Name="analysisModeVisual"/>
        <local:LandingGearVisual x:Name="landingGearVisual"/>
        <local:HardpointsVisual x:Name="hardpointsVisual"/>
        <local:CargoScoopVisual x:Name="cargoScoopVisual"/>
        <local:HeadlightsVisual x:Name="headlightsVisual"/>
        <local:NightVisionVisual x:Name="nightVisionVisual"/>
        <local:ShieldsVisual x:Name="shieldsVisual"/>
        <local:LowFuelVisual x:Name="lowFuelVisual"/>
        <local:OverheatVisual x:Name="overheatVisual"/>
        <local:InterdictionVisual x:Name="interdictionVisual"/>
        <local:InterdictionOutcomeVisual x:Name="interdictionOutcomeVisual"/>
        <local:EngineerVisual x:Name="engineerVisual"/>
        <local:CombatAlertVisual x:Name="combatAlertVisual"/>
        <local:WingCrewVisual x:Name="wingCrewVisual"/>
        <local:BodySignalsVisual x:Name="bodySignalsVisual"/>
        <local:MiningVisual x:Name="miningVisual"/>
        <local:SignalSourceVisual x:Name="signalSourceVisual"/>
        <local:NavBeaconVisual x:Name="navBeaconVisual"/>
        <local:ShipCallVisual x:Name="shipCallVisual"/>
        <local:SearchRescueVisual x:Name="searchRescueVisual"/>
        <local:VoucherVisual x:Name="voucherVisual"/>
        <local:SelfDestructVisual x:Name="selfDestructVisual"/>
        <local:ShipyardVisual x:Name="shipyardVisual"/>
        <local:ModuleVisual x:Name="moduleVisual"/>
        <local:ServicesVisual x:Name="servicesVisual"/>
        <local:GearVisual x:Name="gearVisual"/>
        <local:TaxiVisual x:Name="taxiVisual"/>
        <local:SquadronVisual x:Name="squadronVisual"/>
        <local:PowerplayVisual x:Name="powerplayVisual"/>
        <local:SettlementVisual x:Name="settlementVisual"/>
        <local:SynthesisVisual x:Name="synthesisVisual"/>
        <local:CommunityGoalVisual x:Name="communityGoalVisual"/>
        <local:DiscoveryScanVisual x:Name="discoveryScanVisual"/>
        <local:CrimeVisual x:Name="crimeVisual"/>
        <local:TradeProfitVisual x:Name="tradeProfitVisual"/>
        <local:ExobiologySoldVisual x:Name="exobiologySoldVisual"/>
        <local:CockpitBreachVisual x:Name="cockpitBreachVisual"/>
        <local:CarrierJumpVisual x:Name="carrierJumpVisual"/>
        <local:TechBrokerVisual x:Name="techBrokerVisual"/>
        <local:SilentRunningVisual x:Name="silentRunningVisual"/>
        <local:SupercruiseVisual x:Name="supercruiseVisual"/>
        <local:SupercruiseOverdriveVisual x:Name="supercruiseOverdriveVisual"/>
        <local:SupercruiseAssistVisual x:Name="supercruiseAssistVisual"/>
        <local:SupercruiseExitVisual x:Name="supercruiseExitVisual"/>
        <local:SuperchargeVisual x:Name="superchargeVisual"/>
        <local:RouteVisual x:Name="routeVisual"/>
