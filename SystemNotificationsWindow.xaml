        <local:SrvVisual x:Name="srvVisual"/>
        <local:OrganismScanVisual x:Name="organismScanVisual"/>
        <local:ColonyRangeVisual x:Name="colonyRangeVisual"/>
        <local:HullDamageVisual x:Name="hullDamageVisual"/>
        <local:VitalsVisual x:Name="vitalsVisual"/>
        <local:RankUpVisual x:Name="rankUpVisual"/>
        <local:ThermalVisual x:Name="thermalVisual"/>
        <local:ShipLostVisual x:Name="shipLostVisual"/>
        <local:FighterVisual x:Name="fighterVisual"/>
        <local:MassLockVisual x:Name="massLockVisual"/>
        <local:FsdCooldownVisual x:Name="fsdCooldownVisual"/>
        <local:DockingRequestVisual x:Name="dockingRequestVisual"/>
        <local:DriveAssistVisual x:Name="driveAssistVisual"/>
        <local:HandbrakeVisual x:Name="handbrakeVisual"/>
