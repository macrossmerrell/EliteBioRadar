<Window x:Class="EliteBioRadar.SystemScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Scan"
        Width="860" Height="680"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#0a0f0f"
        FontFamily="Consolas">

    <Window.Resources>
        <!-- Same thin scrollbar as ScanLogWindow/MainWindow's own ThinScrollViewer -->
        <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/>
            <Setter Property="MinWidth" Value="5"/>
            <Setter Property="Background" Value="#0d1a1a"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="5">
                            <Border Background="#0d1a1a" CornerRadius="1"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#1a4444" CornerRadius="1" Margin="0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThinScrollViewer" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Style="{StaticResource ThinScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#0d1a1a" BorderBrush="#1a4444"
                BorderThickness="0,0,0,1" Padding="14,12,10,10">
            <DockPanel>
                <Button x:Name="btnClose" DockPanel.Dock="Right" Content="✕"
                        Width="22" Height="22" Padding="0"
                        Background="#0a1616" Foreground="#88bbbb"
                        BorderBrush="#1a4444" BorderThickness="1"
                        FontFamily="Consolas" FontSize="12"
                        Click="BtnClose_Click"/>
                <Button x:Name="btnRefresh" DockPanel.Dock="Right" Content="⟳"
                        Width="22" Height="22" Padding="0" Margin="0,0,6,0"
                        Background="#0a1616" Foreground="#88bbbb"
                        BorderBrush="#1a4444" BorderThickness="1"
                        FontFamily="Consolas" FontSize="12"
                        ToolTip="Refresh from current scan data"
                        Click="BtnRefresh_Click"/>
                <Button x:Name="btnToggleAll" DockPanel.Dock="Right" Content="Notable Only"
                        Padding="8,3" Margin="0,0,6,0"
                        Background="#0a1616" Foreground="#88bbbb"
                        BorderBrush="#1a4444" BorderThickness="1"
                        FontFamily="Consolas" FontSize="11"
                        ToolTip="Toggle between notable-only and every scanned body"
                        Click="BtnToggleAll_Click"/>
                <Button x:Name="btnToggleBelts" DockPanel.Dock="Right" Content="Hide Belts"
                        Padding="8,3" Margin="0,0,6,0"
                        Background="#0a1616" Foreground="#88bbbb"
                        BorderBrush="#1a4444" BorderThickness="1"
                        FontFamily="Consolas" FontSize="11"
                        ToolTip="Show or hide asteroid belt clusters"
                        Click="BtnToggleBelts_Click"/>
                <Button x:Name="btnToggleFullMats" DockPanel.Dock="Right" Content="Hide Full Mats"
                        Padding="8,3" Margin="0,0,6,0"
                        Background="#0a1616" Foreground="#88bbbb"
                        BorderBrush="#1a4444" BorderThickness="1"
                        FontFamily="Consolas" FontSize="11"
                        ToolTip="Hide material chips for raw materials you already have a full stock of"
                        Click="BtnToggleFullMats_Click"/>
                <TextBlock x:Name="txtEdsmChip" Text="" Foreground="#4c7373"
                           FontSize="10.5" VerticalAlignment="Center" Cursor="Hand"
                           ToolTip="Click to open EDSM settings"
                           DockPanel.Dock="Right" Margin="0,0,10,0"
                           MouseLeftButtonUp="TxtEdsmChip_Click"/>
                <TextBlock Text="SYSTEM SCAN" Foreground="#00e5ff"
                           FontSize="14" FontWeight="Bold" VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <TextBlock x:Name="txtSysName" Text="—" Foreground="#cfe8e8"
                           FontSize="14" FontWeight="Bold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- CONTENT — everything else (trip bar, summary, per-star bodies) is built in
             code-behind into this one scrollable stack, same reasoning as ScanLogWindow's
             own heavily code-behind-built tabs: the content is entirely data-driven. -->
        <ScrollViewer Grid.Row="1" Style="{StaticResource ThinScrollViewer}">
            <StackPanel x:Name="rootStack"/>
        </ScrollViewer>
    </Grid>
</Window>
