<Window x:Class="EliteBioRadar.NearestFinderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Star Finder"
        Width="460" Height="560"
        MinWidth="360" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="#0a0f0f"
        FontFamily="Consolas">

    <Window.Resources>
        <!-- Same thin scrollbar as SystemScanWindow/ScanLogWindow -->
        <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/>
            <Setter Property="MinWidth" Value="5"/>
            <Setter Property="Background" Value="#0d1a1a"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="5">
                            <Border Background="#0d1a1a" CornerRadius="1"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#1a4444" CornerRadius="1" Margin="0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThinScrollViewer" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Style="{StaticResource ThinScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The ComboBox's own Foreground is light teal (readable on its dark closed-box
             background), but that Foreground inherits straight down into the dropdown's
             ComboBoxItems, which otherwise keep the default light/system popup background —
             light-on-light, unreadable. Give the popup its own dark background/highlight so
             item text stays legible regardless of the Windows theme. -->
        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#0d1a1a"/>
            <Setter Property="Foreground" Value="#cfe8e8"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1a4444"/>
                                <Setter Property="Foreground" Value="#00e5ff"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#153636"/>
                                <Setter Property="Foreground" Value="#00e5ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The ComboBox's plain Background/Foreground properties only reach part of the
             default Windows chrome — the CLOSED box's own selection display kept showing white
             behind light teal text regardless (real feedback: "lightblue text on a white
             background"). A full custom template, same idea as ThinScrollBar above, is the only
             reliable fix: every part (toggle chrome, selection text, dropdown popup) is drawn
             with our own dark colors instead of inheriting whatever the OS theme supplies. -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#0d1a1a"/>
            <Setter Property="Foreground" Value="#cfe8e8"/>
            <Setter Property="BorderBrush" Value="#1a4444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0,4,0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M0,0 L4,4 L8,0 Z" Fill="#88bbbb"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="#0d1a1a" BorderBrush="#1a4444" BorderThickness="1">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#0d1a1a" BorderBrush="#1a4444"
                BorderThickness="0,0,0,1" Padding="14,12,10,10">
            <DockPanel>
                <Button x:Name="btnClose" DockPanel.Dock="Right" Content="✕"
                        Width="22" Height="22" Padding="0"
                        Background="#0a1616" Foreground="#88bbbb"
                        BorderBrush="#1a4444" BorderThickness="1"
                        FontFamily="Consolas" FontSize="12"
                        Click="BtnClose_Click"/>
                <TextBlock Text="STAR FINDER" Foreground="#00e5ff"
                           FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ORIGIN -->
        <Border Grid.Row="1" Background="#0e1c1c" BorderBrush="#1a4444"
                BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel>
                <TextBlock Text="FROM: " Foreground="#4c7373" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtOrigin" Text="—" Foreground="#cfe8e8" FontSize="11.5"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- QUERY CONTROLS -->
        <Border Grid.Row="2" Background="#0a1616" BorderBrush="#1a4444"
                BorderThickness="0,0,0,1" Padding="14,10">
            <StackPanel>
                <TextBlock Text="Star type" Foreground="#4c7373" FontSize="10.5" Margin="0,0,0,3"/>
                <ComboBox x:Name="cmbStarType" Height="26" FontFamily="Consolas" FontSize="11.5"
                          Style="{StaticResource DarkComboBox}"/>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Closest" Foreground="#4c7373"
                               FontSize="10.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="txtCount" Grid.Column="1" Text="10" Height="26"
                             FontFamily="Consolas" FontSize="11.5" TextAlignment="Center"
                             Background="#0d1a1a" Foreground="#cfe8e8" BorderBrush="#1a4444"
                             VerticalContentAlignment="Center"/>
                    <Button x:Name="btnFind" Grid.Column="3" Content="FIND"
                            Width="90" Height="28" FontWeight="Bold"
                            Background="#0a2a2e" Foreground="#00e5ff"
                            BorderBrush="#00e5ff" BorderThickness="1"
                            FontFamily="Consolas" FontSize="11.5"
                            Cursor="Hand" Click="BtnFind_Click"/>
                </Grid>

                <TextBlock x:Name="txtStatus" Text="" Foreground="#4c7373" FontSize="10.5"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- RESULTS -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="14,8,14,4" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="RESULTS" Foreground="#4c7373" FontSize="10.5"
                           VerticalAlignment="Center"/>
                <Button x:Name="btnCopyAll" DockPanel.Dock="Right" Content="Copy All"
                        Padding="8,3" Background="#0a1616" Foreground="#88bbbb"
                        BorderBrush="#1a4444" BorderThickness="1"
                        FontFamily="Consolas" FontSize="10.5"
                        Cursor="Hand" Click="BtnCopyAll_Click"/>
            </DockPanel>

            <ScrollViewer Grid.Row="1" Style="{StaticResource ThinScrollViewer}">
                <StackPanel x:Name="resultsStack" Margin="14,0,10,14"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
